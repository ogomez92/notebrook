# --- Push notifications (all optional; see PUSH.md) ---
# iOS via APNs: token auth with a .p8 key from developer.apple.com
#APNS_KEY_PATH=/nb/AuthKey_ABC123DEFG.p8
#APNS_KEY_ID=ABC123DEFG
#APNS_TEAM_ID=4TH9Y6ZAQC
#APNS_BUNDLE_ID=com.oriolgomez.notebrook
# 1 for TestFlight / App Store builds, unset for Xcode debug builds
#APNS_PRODUCTION=0
# Browsers via Web Push: generate with `npm run push:vapid`
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com
#PUSH_BODY_MAX_LENGTH=200
